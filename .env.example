# Hugging Face Access Token (Free User Access Token with Read permission)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_STT_MODEL=gemini-2.5-flash

# Groq API Key (Free 2,000 requests/day, ultra-fast Whisper Large V3)
# Get yours in 10 seconds at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_STT_MODEL=whisper-large-v3-turbo
